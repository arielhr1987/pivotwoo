{
	"phpVersion": null,
	"core": null,
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip",
		"https://downloads.wordpress.org/plugin/query-monitor.latest-stable.zip",
		"https://github.com/woocommerce/wc-smooth-generator/releases/download/1.2.2/wc-smooth-generator.zip",
		"."
	],
	"themes": [
		"https://downloads.wordpress.org/theme/storefront.4.6.0.zip"
	],
	"config": {
		"JETPACK_AUTOLOAD_DEV": true,
		"WP_DEBUG": true,
		"SCRIPT_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": true,
		"WP_TESTS_PHPUNIT_POLYFILLS_PATH": "/var/www/html/wp-content/plugins/pivotwoo/vendor/yoast/phpunit-polyfills"
	},
	"mappings": {
		"wp-content/debug.log": "./logs/debug.log"
	},
	"env": {
		"development": {
			"mysqlPort": 63420,
			"phpmyadminPort": 8887
		}
	}
}
